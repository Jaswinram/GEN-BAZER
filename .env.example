# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Leave as default to connect to local MongoDB, or supply MongoDB Atlas URI
# If MongoDB is unavailable, Gen Baazar automatically operates in embedded hybrid mode
MONGODB_URI=mongodb://127.0.0.1:27017/gen_baazar

# JWT Authentication Secret
JWT_SECRET=gen_baazar_super_secure_secret_key_2026

# Currency Setting (Strictly Indian Rupees)
CURRENCY=INR

# Payment Gateway (Optional Test Keys)
# In safe development mode, simulated instant payment verification is enabled by default
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

